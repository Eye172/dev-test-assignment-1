{
  "name": "orbit-gtm-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --v8-pool-size=1 node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "node --v8-pool-size=1 node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx --wasm-num-compilation-tasks=1 --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --wasm-num-compilation-tasks=1 --conditions=react-server scripts/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-react": "^0.577.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  }
}
