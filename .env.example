# Production: pooled PostgreSQL URL from Supabase (session pooler), Neon, or another host.
DATABASE_URL=
# Local development only: persistent embedded PostgreSQL directory.
PGLITE_DATA_DIR=.data/orbit
# Must be true only for intentionally synthetic, publicly editable demonstration data.
DEMO_MODE=true
# Public deployment origin, e.g. https://orbit.example.com; leave blank locally.
APP_ORIGIN=
# Never set this in a public deployment. Allows production-build E2E to use PGlite locally.
ALLOW_LOCAL_DATABASE=false
# Enable only on a hosting platform that sets/overwrites x-forwarded-for.
TRUST_PROXY=false

# Server-only. Never use NEXT_PUBLIC_ for these values. Paid agents are opt-in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_CRITIC_MODEL=gpt-6-astra
# A long random owner code; unlocks all AI reads, writes and exports for 24 hours.
AI_ACCESS_CODE=
# Estimated USD at configured model/tool rates. Shared across all owner sessions.
AI_RUN_BUDGET_USD=7
AI_DAILY_BUDGET_USD=15
