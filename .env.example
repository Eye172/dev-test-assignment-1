# Production: pooled PostgreSQL URL from Supabase (session pooler), Neon, or another host.
DATABASE_URL=
# Local development only: persistent embedded PostgreSQL directory.
PGLITE_DATA_DIR=.data/orbit
# Must be true only for intentionally synthetic, publicly editable demonstration data.
DEMO_MODE=true
# Public deployment origin, e.g. https://orbit.example.com; leave blank locally.
APP_ORIGIN=
# Never set this in a public deployment. Allows production-build E2E to use PGlite locally.
ALLOW_LOCAL_DATABASE=false
